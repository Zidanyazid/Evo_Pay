# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=0
SIMULATOR_ENABLED=1

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evopay

# Admin security (production: password >=14 chars, encryption key >=32 random chars)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@evopay.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_TTL_MS=28800000
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Tokopay (required in production)
TOKOPAY_MERCHANT_ID=
TOKOPAY_SECRET=
TOKOPAY_API_URL=https://api.tokopay.id/v1
TOKOPAY_WEBHOOK_IPS=178.128.104.179

# Operational limits
WEBHOOK_TIMEOUT_MS=8000
SITE_RATE_LIMIT=120
WORKER_INTERVAL_MS=5000

# Optional notifications

# Observability (required in production; minimum 24 characters)
OBSERVABILITY_TOKEN=replace-with-a-long-private-metrics-token
PAYMENT_EXPIRATION_INTERVAL_MS=60000
PAYMENT_EXPIRATION_BATCH_SIZE=100
SITE_CREATE_PAYMENT_LIMIT_PER_MINUTE=30
SITE_SYNC_PAYMENT_LIMIT_PER_MINUTE=60
